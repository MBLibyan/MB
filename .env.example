# رابط مشروعك في Supabase (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# المفتاح العام لـ Supabase (anon / public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# اسم الـ Bucket المخصص لحفظ ملفات MP3 و MP4 داخل Supabase Storage (افتراضياً: media)
NEXT_PUBLIC_SUPABASE_BUCKET=media
